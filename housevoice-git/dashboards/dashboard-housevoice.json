{
  "button_card_templates": {
    "hv_brand_compact": {
      "card_mod": {
        "style": ":host {\n  background: transparent !important;\n  background-color: transparent !important;\n  --ha-card-background: transparent !important;\n  --card-background-color: transparent !important;\n  --ha-card-border-color: transparent !important;\n  --ha-card-border-width: 0 !important;\n  --ha-card-box-shadow: none !important;\n}\n\nha-card,\nha-card:hover,\nha-card:focus,\nha-card:active,\n.card,\n.card-content,\n#container,\n#card,\n.element {\n  background: transparent !important;\n  background-color: transparent !important;\n  background-image: none !important;\n  border: 0 !important;\n  border-radius: 0 !important;\n  box-shadow: none !important;\n  backdrop-filter: none !important;\n  -webkit-backdrop-filter: none !important;\n  padding: 0 !important;\n  margin: 0 !important;\n  overflow: visible !important;\n}\n\n.hv-brand-lockup {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  justify-content: flex-start;\n  font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  line-height: 1;\n  white-space: nowrap;\n}\n\n.hv-brand-logo {\n  display: block;\n  flex: 0 0 auto;\n  object-fit: contain;\n  object-position: center;\n}\n\n.hv-brand-copy {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  justify-content: center;\n  flex: 0 0 auto;\n  min-width: 0;\n  line-height: 1;\n}\n\n.hv-brand-title {\n  font-weight: 500;\n  line-height: 1;\n  white-space: nowrap;\n}\n\n.hv-brand-command {\n  margin-top: 4px;\n  font-weight: 600;\n  line-height: 1;\n  white-space: nowrap;\n}"
      },
      "custom_fields": {
        "brand": "[[[\nreturn `\n  <div\n    class=\"hv-brand-lockup\"\n    style=\"width:${variables.brand_width};height:${variables.brand_height};gap:${variables.logo_gap};\"\n  >\n    <img\n      class=\"hv-brand-logo\"\n      src=\"/local/housevoice/logo.svg?v=5\"\n      alt=\"HouseVoice\"\n      style=\"width:${variables.logo_width};height:${variables.logo_height};\"\n    />\n    <div class=\"hv-brand-copy\">\n      <div class=\"hv-brand-title\" style=\"color:${variables.title_color};font-size:${variables.title_size};letter-spacing:${variables.title_spacing};\">HOUSEVOICE</div>\n      <div class=\"hv-brand-command\" style=\"color:${variables.command_color};font-size:${variables.command_size};letter-spacing:${variables.command_spacing};\">COMMAND</div>\n    </div>\n  </div>\n`;\n]]]"
      },
      "hold_action": {
        "action": "none"
      },
      "show_icon": false,
      "show_label": false,
      "show_name": false,
      "show_state": false,
      "styles": {
        "card": [
          {
            "width": "[[[return variables.brand_width;]]]"
          },
          {
            "height": "[[[return variables.brand_height;]]]"
          },
          {
            "min-width": "0"
          },
          {
            "min-height": "0"
          },
          {
            "padding": "0"
          },
          {
            "margin": "0"
          },
          {
            "background": "rgba(0,0,0,0) !important"
          },
          {
            "background-color": "rgba(0,0,0,0) !important"
          },
          {
            "background-image": "none !important"
          },
          {
            "border": "0 !important"
          },
          {
            "border-radius": "0 !important"
          },
          {
            "box-shadow": "none !important"
          },
          {
            "backdrop-filter": "none !important"
          },
          {
            "-webkit-backdrop-filter": "none !important"
          },
          {
            "overflow": "visible"
          },
          {
            "justify-self": "start"
          },
          {
            "--ha-card-background": "rgba(0,0,0,0)"
          },
          {
            "--card-background-color": "rgba(0,0,0,0)"
          },
          {
            "--ha-card-border-color": "transparent"
          },
          {
            "--ha-card-border-width": "0"
          },
          {
            "--ha-card-box-shadow": "none"
          }
