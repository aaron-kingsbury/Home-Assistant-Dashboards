    "hv_brand_logo": {
      "card_mod": {
        "style": ":host {\n  background: transparent !important;\n  background-color: transparent !important;\n  --ha-card-background: transparent !important;\n  --card-background-color: transparent !important;\n  --ha-card-border-color: transparent !important;\n  --ha-card-border-width: 0 !important;\n  --ha-card-box-shadow: none !important;\n}\n\nha-card,\nha-card:hover,\nha-card:focus,\nha-card:active,\n.card,\n.card-content,\n#container,\n#card,\n.element {\n  background: transparent !important;\n  background-color: transparent !important;\n  background-image: none !important;\n  border: 0 !important;\n  border-radius: 0 !important;\n  box-shadow: none !important;\n  backdrop-filter: none !important;\n  -webkit-backdrop-filter: none !important;\n  padding: 0 !important;\n  margin: 0 !important;\n  overflow: visible !important;\n}\n\n.hv-brand-stack {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  font-family: Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  line-height: 1;\n  white-space: nowrap;\n}\n\n.hv-brand-logo-frame {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: visible;\n  margin: 0 0 -5px 0;\n}\n\n.hv-brand-logo {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  object-position: center;\n  transform-origin: center center;\n}\n\n.hv-brand-title {\n  margin: 0 0 0 6px;\n  font-weight: 400;\n  line-height: 1;\n  white-space: nowrap;\n}\n\n.hv-brand-command {\n  margin: 7px 0 0 8px;\n  font-weight: 500;\n  line-height: 1;\n  white-space: nowrap;\n}"
      },
      "custom_fields": {
        "brand": "[[[\nreturn `\n  <div\n    class=\"hv-brand-stack\"\n    style=\"\n      width:${variables.brand_width};\n      height:${variables.brand_height};\n    \"\n  >\n    <div\n      class=\"hv-brand-logo-frame\"\n      style=\"\n        width:${variables.logo_width};\n        height:${variables.logo_height};\n      \"\n    >\n      <img\n        class=\"hv-brand-logo\"\n        src=\"/local/housevoice/logo.svg?v=12\"\n        alt=\"HouseVoice\"\n        style=\"transform:scale(${variables.logo_scale});\"\n      />\n    </div>\n\n    <div\n      class=\"hv-brand-title\"\n      style=\"color:${variables.title_color};font-size:${variables.title_size};letter-spacing:${variables.title_spacing};\"\n    >HOUSEVOICE</div>\n\n    <div\n      class=\"hv-brand-command\"\n      style=\"color:${variables.command_color};font-size:${variables.command_size};letter-spacing:${variables.command_spacing};\"\n    >COMMAND</div>\n  </div>\n`;\n]]]"
      },
