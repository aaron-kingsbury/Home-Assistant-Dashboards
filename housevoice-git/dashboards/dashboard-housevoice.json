        "custom_fields": {
          "brand": [
            {
              "grid-area": "brand"
            },
            {
              "width": "100%"
            },
            {
              "height": "100%"
            },
            {
              "align-self": "center"
            },
            {
              "justify-self": "start"
            }
          ]
